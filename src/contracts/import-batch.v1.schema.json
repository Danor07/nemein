{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemein:schema:import-batch:1",
  "title": "Nemein import batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provenance",
    "period",
    "currency",
    "amount_unit",
    "account_id",
    "entries"
  ],
  "properties": {
    "version": { "const": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "connector", "version"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "connector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        }
      }
    },
    "period": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/date" },
            "to": { "$ref": "#/$defs/date" }
          }
        }
      ]
    },
    "currency": { "const": "PYG" },
    "amount_unit": { "const": "integer" },
    "account_id": { "$ref": "#/$defs/id" },
    "entries": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "payee", "amount", "category_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "date": { "$ref": "#/$defs/date" },
          "payee": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "amount": {
            "type": "integer",
            "minimum": -1000000000000,
            "maximum": 1000000000000,
            "not": { "const": 0 }
          },
          "category_id": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
