{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemein:schema:event-stream:1",
  "title": "Nemein stream record v1",
  "description": "NDJSON or JSON-seq record containing a resume cursor and one structured CloudEvent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cursor",
    "event"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "event": {
      "type": "object",
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "time",
        "datacontenttype",
        "dataschema",
        "data"
      ],
      "properties": {
        "specversion": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri-reference"
        },
        "type": {
          "const": "io.nemein.budget.changed.v1"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "datacontenttype": {
          "const": "application/json"
        },
        "dataschema": {
          "const": "urn:nemein:schema:budget-changed:1"
        },
        "data": {
          "$ref": "urn:nemein:schema:budget-changed:1"
        }
      }
    }
  }
}