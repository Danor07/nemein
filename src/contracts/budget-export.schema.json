{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemein:schema:budget-export:1",
  "title": "Nemein financial export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "cursor",
    "exported_at",
    "currency",
    "amount_unit",
    "data"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "exported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "currency": {
      "const": "PYG"
    },
    "amount_unit": {
      "const": "integer"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounts",
        "groups",
        "categories",
        "allocations",
        "transactions",
        "reconciliations",
        "goals",
        "recurring",
        "recurring_occurrences"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "categories": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "allocations": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/allocation"
          }
        },
        "transactions": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/transaction"
          }
        },
        "reconciliations": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/reconciliation"
          }
        },
        "goals": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/goal"
          }
        },
        "recurring": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/recurring"
          }
        },
        "recurring_occurrences": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "enum": ["corriente", "credito", "efectivo"]
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group_id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "group_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "category_id", "amount"],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "category_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "amount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "account_id",
        "date",
        "payee",
        "amount",
        "category_id",
        "kind",
        "cleared",
        "reconciled",
        "transfer_key"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "payee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "category_id": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": ["normal", "opening", "transfer"]
        },
        "cleared": {
          "type": "integer",
          "enum": [0, 1]
        },
        "reconciled": {
          "type": "integer",
          "enum": [0, 1]
        },
        "transfer_key": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account_id", "date", "balance"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "balance": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "amount", "due_date"],
      "properties": {
        "category_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "due_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "recurring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "account_id",
        "category_id",
        "payee",
        "amount",
        "next_date",
        "frequency",
        "anchor_day",
        "active"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "category_id": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "payee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "next_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "frequency": {
          "enum": ["weekly", "monthly", "yearly"]
        },
        "anchor_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "active": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recurring_id", "due_date", "transaction_id"],
      "properties": {
        "recurring_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "due_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "transaction_id": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
