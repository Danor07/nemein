<% const decisions={allow:"Permitido",deny:"Negado",ask:"Para revisar",error:"Falló",accepted:"Aceptado",modified:"Modificado",rejected:"Rechazado"}; const adminActions={"connection-create":"Crear conexión","connection-revoke":"Revocar conexión","connection-version":"Cambiar versión","connection-rotate":"Renovar token","permission-set":"Actualizar permiso","permissions":"Consultar permisos propios"}; %>
<div class="page-title"><div><span class="eyebrow">Control de acceso</span><h1>Permisos y propuestas</h1><p>Elegí qué puede hacer cada conexión. Lo que no autorizás queda bloqueado.</p></div></div>
<% if(newConnection){ %><section class="panel"><h2>Guardá la configuración de <%= newConnection.label %></h2><p>La credencial se guarda en un archivo local protegido. La configuración contiene su ruta, sin mostrar el token.</p>
<% if(connectionConfig){ %><form method="post" action="/agent-config"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="export_id" value="<%= exportId %>"><button data-mcp-download aria-describedby="mcp-download-status">Descargar configuración MCP</button></form><p id="mcp-download-status" role="status" aria-live="polite" class="footnote">Buscá nemein-mcp.json en Descargas. La descarga estará disponible diez minutos en esta sesión.</p><details class="spaced"><summary>Ver configuración para copiar</summary><pre><%= JSON.stringify(connectionConfig,null,2) %></pre></details>
<% }else{ %><p>Instalá o actualizá Nemein para generar una configuración con permisos. La versión instalada debe ser 0.2.2 o posterior. Si usás Codex, ejecutá el instalador desde el Explorador de Windows.</p><% } %></section><% } %>
<section class="panel spaced"><h2>Agregar conexión</h2><p>Cada cliente o integración tiene su propio token y comienza sin permisos.</p><form method="post" action="/action/connection-create" class="connection-create"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><label>Nombre del cliente<input name="label" maxlength="100" placeholder="Mi asistente" required></label><label>Versión de la conexión<input name="version" value="1" pattern="[a-zA-Z0-9._-]{1,40}" required></label><button>Crear conexión sin permisos</button></form></section>
<section class="panel spaced"><h2>Conexiones</h2>
<% if(!access.connections.length){ %><p>No hay conexiones. Creá una para configurar su acceso.</p><% } %>
<% for(const connection of access.connections){ %><details class="connection-card"><summary><%= connection.label %> · versión <%= connection.version %> · <%= connection.active?'Activa':'Revocada' %></summary><p class="footnote">Un token autoriza sólo lo que permitas abajo. Las acciones nuevas permanecen bloqueadas.</p>
<% if(connection.active){ %><div class="row-actions"><form method="post" action="/action/connection-revoke" data-confirm="¿Revocar la conexión? Sus próximos pedidos y lecturas quedarán bloqueados."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= connection.id %>"><button class="secondary">Revocar conexión</button></form><form method="post" action="/action/connection-rotate" data-confirm="¿Generar un token nuevo? El token anterior dejará de funcionar y tendrás que actualizar tu cliente."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= connection.id %>"><button class="secondary">Renovar token</button></form></div>
<details class="spaced"><summary>Cambiar versión y retirar permisos</summary><form method="post" action="/action/connection-version"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= connection.id %>"><label>Nueva versión<input name="version" pattern="[a-zA-Z0-9._-]{1,40}" required></label><p>Se retirarán todos los permisos; revisalos antes de volver a conectar.</p><button class="secondary">Cambiar versión sin permisos</button></form></details>
<% for(const [action,spec] of Object.entries(access.actions)){ const rule=access.rules.find(r=>r.connection_id===connection.id && r.connection_version===connection.version && r.action===action);const c=rule?.conditions||{}; %>
<form method="post" action="/action/permission-set" class="permission-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="connection_id" value="<%= connection.id %>"><input type="hidden" name="action" value="<%= action %>"><div><strong><%= spec.label %></strong><small><%= spec.write?'Puede cambiar datos':'Consulta o respaldo' %></small></div><label>Permiso<select name="decision"><% for(const [value,label] of [['deny','Negar'],['ask','Preguntar'],['allow','Permitir']]){ if(spec.async && value==='ask')continue; %><option value="<%= value %>" <%= (rule?.decision||'deny')===value?'selected':'' %>><%= label %></option><% } %></select></label>
<% if(spec.money){ %><label>Importe absoluto máximo<input name="max_amount" value="<%= c.max_amount??'' %>" inputmode="numeric" pattern="[0-9]*" placeholder="Sin límite"></label><% } %>
<% if(spec.account){ %><label>Cuenta permitida<select name="account_id"><option value="">Todas las cuentas</option><% for(const account of accounts){ %><option value="<%= account.id %>" <%= c.account_id===account.id?'selected':'' %>><%= account.name %></option><% } %></select></label><% } %>
<% if(spec.money || spec.account){ %><label>Fuera del límite<select name="otherwise"><option value="deny" <%= c.otherwise!=='ask'?'selected':'' %>>Negar</option><option value="ask" <%= c.otherwise==='ask'?'selected':'' %>>Preguntar</option></select></label><% } %><button class="secondary">Guardar permiso</button></form><% } %>
<% } %></details><% } %></section>
<section class="panel spaced"><h2>Bandeja de propuestas</h2><p><%= access.proposalTotal %> recibidas · Las pendientes aparecen primero.</p><p>Revisá los argumentos antes de aceptar. Una base que cambió exige una propuesta nueva.</p>
<% if(!access.proposals.length){ %><p>No hay propuestas recibidas.</p><% } %>
<% const statusLabel={pending:'Pendiente',accepted:'Aceptada',modified:'Modificada',rejected:'Rechazada'}; for(const proposal of access.proposals){ %><article class="proposal-card"><h3><%= access.actions[proposal.action]?.label||proposal.action %></h3><p><strong><%= proposal.label %></strong> · <%= statusLabel[proposal.status] %></p><p><%= proposal.purpose %></p><details><summary>Ver argumentos propuestos</summary><pre><%= JSON.stringify(proposal.args,null,2) %></pre></details>
<% if(proposal.status==='pending'){ %><form method="post" action="/action/proposal-resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= proposal.id %>"><input type="hidden" name="decision" value="accept"><% if(proposal.conflict){ %><p class="error" role="status">El presupuesto cambió desde esta propuesta. Pedí una nueva con la base actual o rechazá esta.</p><% } %><button <%= proposal.conflict?"disabled":"" %>>Aceptar propuesta</button></form>
<details class="spaced"><summary>Modificar antes de aceptar</summary><form method="post" action="/action/proposal-resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= proposal.id %>"><input type="hidden" name="decision" value="modify"><label>Argumentos JSON<textarea name="args" rows="8" required><%= JSON.stringify(proposal.args,null,2) %></textarea></label><label>Motivo del cambio<input name="reason" maxlength="500" required></label><p>Se conservan los argumentos originales y los modificados.</p><button class="secondary" <%= proposal.conflict?"disabled":"" %>>Aceptar con cambios</button></form></details>
<form method="post" action="/action/proposal-resolve" class="spaced"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="view" value="access"><input type="hidden" name="id" value="<%= proposal.id %>"><input type="hidden" name="decision" value="reject"><label>Motivo del rechazo<input name="reason" maxlength="500" required></label><button class="secondary">Rechazar propuesta</button></form>
<% }else{ %><% if(proposal.reason){ %><p><%= proposal.reason %></p><% } %><% if(proposal.final_args){ %><details><summary>Ver argumentos finales</summary><pre><%= JSON.stringify(proposal.final_args,null,2) %></pre></details><% } %><% } %></article><% } %></section>
<div class="row-actions spaced"><% if(access.proposalOffset>0){ %><a class="button secondary" href="/?view=access&proposalOffset=<%= Math.max(0,access.proposalOffset-50) %>">Propuestas anteriores</a><% } %><% if(access.proposalOffset+50<access.proposalTotal){ %><a class="button secondary" href="/?view=access&proposalOffset=<%= access.proposalOffset+50 %>">Más propuestas</a><% } %></div><details class="panel spaced"><summary>Registro de decisiones recientes</summary><% for(const record of access.audit){ %><div class="audit-row"><strong><%= record.actor==='owner'?'Vos':access.connections.find(c=>c.id===record.actor)?.label||'Conexión' %></strong><span><%= access.actions[record.action]?.label||adminActions[record.action]||"Administrar acceso" %> · <%= decisions[record.decision]||record.decision %></span><small><%= record.at %> · <%= record.reason %></small><details><summary>Argumentos</summary><pre><%= JSON.stringify(record.args,null,2) %></pre></details></div><% } %></details>
