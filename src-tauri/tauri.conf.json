{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nemein",
  "version": "0.4.0",
  "identifier": "local.presupuesto.cero",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nemein-connector"
    ],
    "resources": {
      "../desktop-resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ],
        "compression": "zlib",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
