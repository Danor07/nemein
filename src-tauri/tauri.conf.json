{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presupuesto Cero",
  "version": "0.1.0",
  "identifier": "local.presupuesto.cero",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../desktop-resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Spanish"]
      }
    }
  }
}
